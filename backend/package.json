{
  "name": "wpintel-backend",
  "version": "2.0.0",
  "description": "Web Performance Intelligence -- Backend (Performance Auditor V2)",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:generate:test": "prisma generate --schema prisma/schema.test.prisma",
    "prisma:test:push": "prisma db push --schema prisma/schema.test.prisma --skip-generate",
    "prisma:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "test": "prisma generate --schema prisma/schema.test.prisma && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "prisma": "^6.19.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}