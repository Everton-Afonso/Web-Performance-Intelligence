# Web Performance Intelligence -- Backend environment variables
# Port where the API server listens
PORT=3000

# Optional Google PageSpeed Insights API key.
# WARNING: never expose this in the frontend bundle.
# If unset, requests run without a key (lower rate limits).
PAGESPEED_API_KEY=

# Base URL of the Google PageSpeed Insights v5 API
PAGESPEED_API_URL=https://www.googleapis.com/pagespeedonline/v5/runPagespeed

# Timeout (ms) for the PageSpeed request
PAGESPEED_TIMEOUT_MS=60000

# BigQuery/CrUX API key (reuses PAGESPEED_API_KEY by default; set only if distinct)
CRUX_API_KEY=

# Base URL of the Chrome UX Report API v1
CRUX_API_URL=https://chromeuxreport.googleapis.com/v1/records:queryRecord

# Comma separated list of allowed CORS origins. "*" allows any origin.
CORS_ORIGIN=*

# PostgreSQL connection string used by Prisma (V2 persistence)
# Porta 5433 = Postgres do docker compose (o 5432 costuma já ter um Postgres local)
DATABASE_URL=postgresql://wpintel:wpintel@localhost:5433/wpintel

# SQLite connection used ONLY by the test schema (tests/repositories)
DATABASE_URL_TEST=file:./test.db