generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@wpintel/prisma-test"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL_TEST")
}

// Test-only schema: mirrors schema.prisma using SQLite so repository tests run
// without a Postgres server. Keep the models in sync when schema.prisma changes.

model Project {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  sites     Site[]
}

model Site {
  id        String   @id @default(uuid())
  name      String
  url       String
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  analyses  Analysis[]
  monitors  Monitor[]
  alerts    Alert[]
  goals     Goal[]

  @@unique([url])
  @@index([name])
  @@index([projectId])
}

model Monitor {
  id            String   @id @default(uuid())
  siteId        String
  strategy      String
  intervalHours Int
  enabled       Boolean  @default(true)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdAt     DateTime @default(now())
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([enabled, nextRunAt])
}

model Alert {
  id         String   @id @default(uuid())
  siteId     String
  type       String
  metric     String
  severity   String
  message    String
  analysisId String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([read, createdAt])
}

model Goal {
  id        String   @id @default(uuid())
  siteId    String
  metric    String
  target    Float
  operator  String
  createdAt DateTime @default(now())
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, metric])
  @@index([siteId])
}

model Analysis {
  id          String   @id @default(uuid())
  siteId      String
  url         String
  strategy    String
  score       Float
  analyzedAt  DateTime
  finalUrl    String
  fetchTime   DateTime
  fieldLcp    Float?
  fieldInp    Float?
  fieldCls    Float?
  fieldFcp    Float?
  fieldTtfb   Float?
  webPageTestStatus String?
  webPageTestTestId String?
  webPageTestAnalyzedAt DateTime?
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  metrics     Metric[]
  audits      Audit[]
  recommendations Recommendation[]
  webPageTestResults WebPageTestResult[]
  baselineOf  Comparison[] @relation("BaselineComparison")
  currentOf   Comparison[] @relation("CurrentComparison")

  @@index([siteId, strategy, analyzedAt])
  @@index([url, strategy, analyzedAt])
}

model WebPageTestResult {
  id            String   @id @default(uuid())
  analysisId    String
  testId        String
  status        String
  metrics       Json
  topRequests   Json
  requests      Int
  bytes         Float
  waterfallRef  String?
  analyzedAt    DateTime @default(now())
  analysis      Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@unique([analysisId])
  @@index([analysisId])
}

model Metric {
  id         String  @id @default(uuid())
  analysisId String
  source     String  @default("lab")
  name       String
  value      Float?
  unit       String
  status     String?
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([name])
}

model Audit {
  id          String  @id @default(uuid())
  analysisId  String
  source      String  @default("lab")
  auditId     String
  title       String
  description String
  score       Float?
  numericValue Float?
  displayValue String?
  severity    String
  impact      String
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model Comparison {
  id                 String   @id @default(uuid())
  baselineAnalysisId String
  currentAnalysisId  String
  createdAt          DateTime @default(now())
  results            Json
  baselineAnalysis   Analysis @relation("BaselineComparison", fields: [baselineAnalysisId], references: [id], onDelete: Cascade)
  currentAnalysis    Analysis @relation("CurrentComparison", fields: [currentAnalysisId], references: [id], onDelete: Cascade)

  @@index([baselineAnalysisId])
  @@index([currentAnalysisId])
}

model Recommendation {
  id            String  @id @default(uuid())
  analysisId    String
  targetType    String
  targetId      String
  category      String
  priority      String
  title         String
  description   String
  cause         String
  recommendedFix String
  expectedImpact String
  suggestedFix  String?
  evidence      Json
  analysis      Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}